# Скопируй этот файл в agents/.env и впиши свои ключи.
# Файл .env в git НЕ попадает (см. .gitignore).

# --- Агент 1: поиск фото на бесплатных стоках ---
# https://www.pexels.com/api/  (бесплатно)
PEXELS_API_KEY=
# https://unsplash.com/developers  (бесплатно, Access Key)
UNSPLASH_ACCESS_KEY=

# --- Агент 2: оживление фото ---
# replicate — модель Kling через Replicate, оплата за каждое видео (по умолчанию)
# kling — прямой API Kling, нужен купленный пакет (от $700)
ANIMATE_PROVIDER=replicate
REPLICATE_VIDEO_MODEL=kwaivgi/kling-v2.1
# https://app.klingai.com/global/dev  -> API Keys
# Если кабинет выдал ОДИН ключ — впиши его сюда:
KLING_API_KEY=
# Если выдал ДВА (Access Key и Secret Key) — сюда:
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_API_BASE=https://api-singapore.klingai.com
KLING_MODEL=kling-v2-1
# std — дешевле, pro — качественнее
KLING_MODE=std
# 5 или 10 секунд
KLING_DURATION=5
KLING_DEFAULT_PROMPT=Плавный кинематографичный наезд камеры, мягкий естественный свет, лёгкое движение штор и листвы, премиальная атмосфера, без людей

# --- Google Drive ---
# ID корневой папки (из адреса папки в браузере: drive.google.com/drive/folders/<ID>)
DRIVE_ROOT_FOLDER_ID=
# OAuth-файл из Google Cloud Console (тип «Desktop app»)
GOOGLE_CREDENTIALS_FILE=credentials.json

# --- Агент 3: колоризация старых фото ---
# https://replicate.com/account/api-tokens  (оплата по факту, ~4 цента за фото)
REPLICATE_API_TOKEN=
COLORIZE_MODEL=black-forest-labs/flux-kontext-pro
# Генерация G-кадров по брифу (run_brief.py generate)
GENERATE_MODEL=black-forest-labs/flux-1.1-pro
